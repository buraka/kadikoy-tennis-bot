{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFormation",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:aws:cloudformation:eu-central-1:*:stack/serverless-tennis-bot-*/*"
      ]
    },
    {
      "Sid": "CloudFormationGlobal",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:ListStacks",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeType"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Lambda",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:eu-central-1:*:function:serverless-tennis-bot-*"
    },
    {
      "Sid": "LambdaGlobal",
      "Effect": "Allow",
      "Action": ["lambda:ListFunctions", "lambda:GetAccountSettings"],
      "Resource": "*"
    },
    {
      "Sid": "ExecutionRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::*:role/serverless-tennis-bot-*"
    },
    {
      "Sid": "Buckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::serverless-tennis-bot-*",
        "arn:aws:s3:::serverless-tennis-bot-*/*"
      ]
    },
    {
      "Sid": "Tables",
      "Effect": "Allow",
      "Action": "dynamodb:*",
      "Resource": "arn:aws:dynamodb:eu-central-1:*:table/serverless-tennis-bot-*"
    },
    {
      "Sid": "Schedules",
      "Effect": "Allow",
      "Action": "events:*",
      "Resource": "arn:aws:events:eu-central-1:*:rule/serverless-tennis-bot-*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": [
        "arn:aws:logs:eu-central-1:*:log-group:/aws/lambda/serverless-tennis-bot-*",
        "arn:aws:logs:eu-central-1:*:log-group:/aws/lambda/serverless-tennis-bot-*:*"
      ]
    },
    {
      "Sid": "LogsGlobal",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Sid": "Secrets",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:AddTagsToResource"
      ],
      "Resource": "arn:aws:ssm:eu-central-1:*:parameter/tennis/*"
    },
    {
      "Sid": "SecretsList",
      "Effect": "Allow",
      "Action": "ssm:DescribeParameters",
      "Resource": "*"
    }
  ]
}
